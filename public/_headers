# Cloudflare Pages headers.
#
# Route handlers that prerender to static files lose the headers they set in
# code — Pages serves the file, not the handler — so the Content-Type and
# robots directives for the machine-readable routes have to be declared here.
# @cloudflare/next-on-pages appends its own block below; leave it alone.

/md/*
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

# === START AUTOGENERATED @cloudflare/next-on-pages IMMUTABLE HEADERS ===
/_next/static/*
  cache-control: public,max-age=31536000,immutable
# === END AUTOGENERATED @cloudflare/next-on-pages IMMUTABLE HEADERS ===
